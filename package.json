{
  "name": "mouse-trail",
  "version": "1.1.0",
  "description": "Glowing mouse trail overlay for Windows",
  "main": "main.js",
  "author": "충남삼성고 홍권능",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/logic.test.js",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.wizbeee.mousetrail",
    "productName": "Mouse Trail",
    "files": [
      "main.js",
      "store.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "settings.html",
      "settings.js",
      "settings-preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MouseTrail-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mouse Trail"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wizbeee",
        "repo": "mouse-trail",
        "releaseType": "release"
      }
    ]
  }
}
