{
  "name": "mouse-trail",
  "version": "1.1.3",
  "description": "Glowing mouse trail overlay for Windows",
  "main": "main.js",
  "author": "충남삼성고 홍권능",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/logic.test.js",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.wizbeee.mousetrail",
    "productName": "Mouse Trail",
    "files": [
      "main.js",
      "store.js",
      "slideshow.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "settings.html",
      "settings.js",
      "settings-preload.js",
      "package.json",
      "!node_modules/uiohook-napi/prebuilds/{darwin,linux}-*/**",
      "!node_modules/uiohook-napi/prebuilds/win32-arm64/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MouseTrail-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mouse Trail",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wizbeee",
        "repo": "mouse-trail",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  }
}
